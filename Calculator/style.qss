/* 计算器样式表
   配色只有一个强调色 #1f6f78，背景和边框用中性灰，避免出现纯黑纯白 */
QWidget#Calculator {
    background-color: #f2f3f5;
}

QLabel#expressionLabel {
    color: #6b7075;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 13px;
    padding-right: 6px;
}

QLineEdit#displayEdit {
    background-color: #ffffff;
    border: 1px solid #dcdfe4;
    border-radius: 10px;
    padding: 0 14px;
    color: #1d2024;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 30px;
    font-weight: 600;
}

QLineEdit#displayEdit[state="error"] {
    color: #a4553f;
    font-size: 18px;
    font-weight: 500;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #dcdfe4;
    border-radius: 10px;
    color: #1d2024;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 18px;
}

QPushButton:hover {
    background-color: #f7f8fa;
}

QPushButton:pressed {
    background-color: #e6e9ee;
}

QPushButton[kind="func"] {
    color: #4a5057;
    font-size: 16px;
}

QPushButton[kind="op"] {
    background-color: #e8f2f3;
    border-color: #cfe3e5;
    color: #1f6f78;
    font-size: 20px;
}

QPushButton[kind="op"]:hover {
    background-color: #dcecee;
}

QPushButton[kind="op"]:pressed {
    background-color: #cfe4e6;
}

QPushButton[kind="equals"] {
    background-color: #1f6f78;
    border-color: #1f6f78;
    color: #ffffff;
    font-size: 20px;
}

QPushButton[kind="equals"]:hover {
    background-color: #2a7f89;
}

QPushButton[kind="equals"]:pressed {
    background-color: #195e66;
}
